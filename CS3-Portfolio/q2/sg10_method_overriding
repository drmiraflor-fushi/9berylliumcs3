class Animal:
  def __init__ (self, name):
    self._name = name

  @property
  def name(self):
    return self._name

  def eat(self):
    pass

  def make_sound(self):
    pass

class Lion(Animal):
  def eat(self):
    print(f"{self.name} eats fresh meat.")

  def make_sound(self):
    print(f"{self.name} roars loudly!")

class Elephant(Animal):
  def eat(self):
    print(f"{self.name} eats grass and fruit.")

  def make_sound(self):
    print(f"{self.name} trumpets!")

class Monkey(Animal):
  def eat(self):
    print(f"{self.name} eats banana.")

  def make_sound(self):
    print(f"{self.name} chatters!")

lion = Lion("Kaveh") 
elephant = Elephant("Meena") 
monkey = Monkey("Boots")

lion.make_sound()
lion.eat()
print("-----")

elephant.make_sound()
elephant.eat()
print("-----")

monkey.make_sound()
monkey.eat()
print("-----")
 
